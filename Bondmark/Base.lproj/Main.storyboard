<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="nav">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene-nav">
            <objects>
                <navigationController id="nav" sceneMemberID="viewController" customClass="ManifestNavigationController" customModule="Bondmark" customModuleProvider="target">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="nav-bar"/>
                    <connections>
                        <segue destination="manifest" kind="relationship" relationship="rootViewController" id="seg-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="nav-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
        <scene sceneID="scene-manifest">
            <objects>
                <viewController id="manifest" customClass="ManifestViewController" customModule="Bondmark" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="manifest-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                    </view>
                    <navigationItem key="navigationItem" id="manifest-nav"/>
                    <connections>
                        <segue destination="inventory" kind="presentation" identifier="showInventory" modalPresentationStyle="pageSheet" id="seg-inventory"/>
                        <segue destination="lifecycle" kind="presentation" identifier="showLifecycle" modalPresentationStyle="pageSheet" id="seg-lifecycle"/>
                        <segue destination="settings" kind="show" identifier="showSettings" id="seg-settings"/>
                        <segue destination="scan" kind="presentation" identifier="showScan" modalPresentationStyle="fullScreen" id="seg-scan"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="manifest-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="900" y="0"/>
        </scene>
        <scene sceneID="scene-inventory">
            <objects>
                <viewController id="inventory" customClass="InventoryViewController" customModule="Bondmark" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="inventory-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="inventory-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1800" y="-400"/>
        </scene>
        <scene sceneID="scene-lifecycle">
            <objects>
                <viewController id="lifecycle" customClass="LifecycleViewController" customModule="Bondmark" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="lifecycle-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="lifecycle-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1800" y="0"/>
        </scene>
        <scene sceneID="scene-settings">
            <objects>
                <viewController id="settings" customClass="SettingsViewController" customModule="Bondmark" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="settings-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="settings-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1800" y="400"/>
        </scene>
        <scene sceneID="scene-scan">
            <objects>
                <viewController id="scan" customClass="ScanCoverViewController" customModule="Bondmark" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="scan-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="scan-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1800" y="800"/>
        </scene>
    </scenes>
</document>
